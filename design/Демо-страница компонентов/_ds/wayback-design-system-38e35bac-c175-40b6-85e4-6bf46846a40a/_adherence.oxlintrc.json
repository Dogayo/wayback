      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|password|search|number)$/]",
        "message": "<TextField> type must be one of 'text' | 'password' | 'search' | 'number'."
